# Required for real accounts, orders, admin and RSVP. Supabase pooled connection string (with SSL)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# At least 32 random characters. Generate: openssl rand -base64 48
SESSION_SECRET="REPLACE_WITH_A_LONG_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
# Set to your deployed public HTTPS origin, no trailing slash
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# PayChangu dashboard: Developer / API keys. Never prefix NEXT_PUBLIC_
PAYCHANGU_SECRET_KEY=""
PAYCHANGU_WEBHOOK_SECRET=""
# Bootstrap a real admin by providing BOTH before running npm run db:seed.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Optional demo mode: content fallbacks visible if DB isn't ready. Seed data are illustrative.

# OPTIONAL: staging only. Do not use true for production.
SEED_DEMO_CONTENT="false"
